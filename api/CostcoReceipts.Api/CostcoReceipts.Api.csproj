<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7de9f1ae-c6dc-4b99-9935-af92424f5282</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.100.6" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.2" />
    <PackageReference Include="AWSSDK.SSO" Version="4.0.100.6" />
    <PackageReference Include="AWSSDK.SSOOIDC" Version="4.0.100.6" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pomelo has no EF Core 10 release; this fork of it keeps the same public
         API (UseMySql, ServerVersion) and annotation names. It requires
         Microsoft.EntityFrameworkCore.Relational [own version, 10.0.999], so the
         EF packages above can never be older than it. -->
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="10.0.14" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>
