# Copy to `.env` (gitignored — see repo .gitignore's plain `.env` pattern)
# and fill in real values. Consumed by docker-compose.prod.yml via
# `env_file`. Double-underscores map to nested appsettings keys
# (ASP.NET Core config convention), e.g. ConnectionStrings__MySql ->
# ConnectionStrings:MySql.

# costco_app@127.0.0.1 — DML only, see MariaDB setup notes.
ConnectionStrings__MySql=Server=127.0.0.1;Port=3306;Database=costco_receipts;User=costco_app;Password=CHANGE_ME;

Auth0__Domain=your-tenant.us.auth0.com
Auth0__Audience=https://your-api-audience/

S3__BucketName=your-bucket-name

# Region is app config; the access key pair below are the AWS SDK's own
# well-known env var names, picked up by the default credential chain
# since AWS__Profile is left unset (see redesign-plan.md's IAM-user
# decision for the Pi — this is a plain access key, not a role).
AWS__Region=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# Shared secret for the internal OCR-results bridge endpoint
# (POST /api/internal/receipts/{id}/ocr-results) — only relevant once
# Phase 2 Part B is cut over.
InternalApi__SharedSecret=CHANGE_ME

Frontend__BaseUrl=https://your-frontend-domain

Cors__AllowedOrigins__0=https://your-frontend-domain
